// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  // Roles Administrativos (Dashboard)
  SUPER_ADMIN
  ADMIN_SECUNDARIO
  
  // Roles Operativos (Registro Asistencia)
  DOCENTE
  TECNICO
  PACIENTE_SIMULADO
}

enum RecordType {
  ENTRADA
  SALIDA
}

enum RecordStatus {
  A_TIEMPO
  TARDANZA
  FALTA
  EXCEPCION
}

enum Shift {
  MANANA      // ~06:00 / 08:00
  INTERMEDIO  // ~09:00 / 11:00
  TARDE       // ~13:00 / 14:00
  NOCHE       // ~19:00 / 20:00 / 21:00
  DESCANSO    // Día libre programado / descanso semanal
  COMISION    // Comisión de servicio / Evento especial en provincia ("EV")
}

// ------------------------------------------------------
// MODELOS
// ------------------------------------------------------

model User {
  id                  String               @id @default(cuid())
  name                String
  dni                 String               @unique
  email               String?              @unique 
  password            String?
  // Rol operativo de asistencia (DOCENTE, TECNICO, PACIENTE_SIMULADO)
  role                Role                 @default(DOCENTE)

  // Rol administrativo secundario/superadmin (si tiene acceso al dashboard)
  adminRole           Role?

  permissions         String[]             @default([])
  
  // Sede base (predeterminada) del usuario
  campusId            String?
  campus              Campus?              @relation(fields: [campusId], references: [id])
  
  // Turno base (predeterminado) para técnicos
  defaultShift        Shift?

  // Requerir cambio de contraseña al primer inicio
  mustChangePassword  Boolean              @default(false)

  records             AttendanceRecord[]
  technicianSchedules TechnicianSchedule[]
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Campus {
  id             String    @id @default(cuid())
  name           String    @unique // Ej: "Campus Villa"

  // Geocerca (límite por geolocalización)
  geoEnforced    Boolean   @default(false)
  latitude       Float?
  longitude      Float?
  radiusMeters   Int       @default(300)

  users               User[]
  records             AttendanceRecord[]
  rules               ToleranceRule[]
  technicianSchedules TechnicianSchedule[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Course {
  id            String    @id @default(cuid())
  name          String    @unique
  
  records       AttendanceRecord[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AttendanceRecord {
  id            String    @id @default(cuid())
  
  // Quién registró
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  // Cuándo y qué registró
  timestamp     DateTime  @default(now())
  type          RecordType
  
  // Contexto del registro (Docentes/Pacientes)
  campusId      String?
  campus        Campus?   @relation(fields: [campusId], references: [id])
  
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id])
  
  // Auditoría y Estado
  status        RecordStatus @default(A_TIEMPO)
  isOfflineSync Boolean      @default(false) // True si la PWA guardó el registro localmente y lo subió luego
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Índices para consultas rápidas en el Dashboard
  @@index([userId])
  @@index([timestamp])
  @@index([campusId])
}

model ToleranceRule {
  id                    String   @id @default(cuid())
  
  name                  String?  // Nombre descriptivo (ej: "Turno Mañana Villa", "Guardia Nocturna")
  shift                 Shift?   // Turno al que pertenece la regla (MANANA, INTERMEDIO, TARDE, NOCHE)
  daysOfWeek            String?  // Días aplicables: ej: "1,2,3,4,5" (1=Lun..5=Vie, 6=Sáb, 0=Dom), null = Todos los días
  
  campusId              String?  
  campus                Campus?  @relation(fields: [campusId], references: [id])
  role                  Role?    
  
  expectedEntryTime          String   // Formato "HH:mm", Ej: "08:00"
  earlyEntryToleranceMinutes Int      @default(15) // Minutos máximos antes de la hora oficial en que se permite marcar entrada
  gracePeriodMinutes         Int      @default(0)  
  lateToleranceMinutes       Int      @default(15) 

  // Opciones de activación/desactivación
  enableEarlyTolerance       Boolean  @default(true) // Activar/desactivar restricción de hora anticipada de ingreso
  enableLateTolerance        Boolean  @default(true) // Activar/desactivar cálculo y control de tardanzas
  
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// ------------------------------------------------------
// CRONOGRAMA / ASIGNACIÓN DE TURNOS PARA TÉCNICOS
// ------------------------------------------------------
model TechnicianSchedule {
  id                         String   @id @default(cuid())
  
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Fecha en formato "YYYY-MM-DD" para coincidencia rápida de calendario
  date                       String
  
  // Sede asignada ese día
  campusId                   String
  campus                     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  
  // Turno asignado
  shift                      Shift    @default(MANANA)
  
  // Horario esperado de entrada para ese turno (ej: "07:00", "11:00", "14:00")
  expectedEntryTime          String   @default("07:00")
  
  // Tolerancias específicas para este día/turno (o hereda predeterminado)
  earlyEntryToleranceMinutes Int      @default(15)
  gracePeriodMinutes         Int      @default(10)
  lateToleranceMinutes       Int      @default(30)

  // Opciones de activación/desactivación
  enableEarlyTolerance       Boolean  @default(true) // Activar/desactivar restricción de hora anticipada de ingreso
  enableLateTolerance        Boolean  @default(true) // Activar/desactivar cálculo y control de tardanzas
  
  notes                      String?  // Ej: "Cubriendo a Pedro", "Rotación Villa"
  
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([campusId])
}

// ------------------------------------------------------
// CONFIGURACIONES GENERALES DEL SISTEMA
// ------------------------------------------------------
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique // Ej: "OVERTIME_MIN_MINUTES", "OVERTIME_ROUNDING_MODE"
  value       String   // Ej: "60"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
